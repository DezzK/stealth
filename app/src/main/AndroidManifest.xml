<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        tools:ignore="MissingApplicationIcon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
        </activity>

        <receiver android:name=".HardwareKeysReceiver" android:enabled="true" android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT"/>
                <action android:name="ecarx.intent.action.ECARX_KEY_ISRC_EVENT"/>
                <action android:name="ecarx.intent.action.ECARX_KEY_ISRC_EVENT_DOWN"/>
                <action android:name="ecarx.intent.action.ECARX_KEY_ISRC_EVENT_UP"/>
                <action android:name="ecarx.intent.action.ECARX_KEY_RSRC_EVENT_DOWN"/>
                <action android:name="ecarx.intent.action.ECARX_KEY_RSRC_EVENT_UP"/>
                <action android:name="ecarx.intent.action.ECARX_KEY_RSRC_EVENT"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
